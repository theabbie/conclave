{
  "name": "conclave",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "pages:build": "npm run build && node scripts/pages.mjs",
    "test": "vitest run",
    "server:dev": "wrangler dev",
    "server:deploy": "wrangler deploy",
    "api:generate": "node scripts/deploy/generate-api-units.mjs",
    "release:prepare": "node scripts/deploy/prepare.mjs",
    "release:publish": "node scripts/deploy/publish.mjs",
    "format": "prettier --write src server *.json *.jsonc *.ts index.html"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "esbuild-wasm": "^0.25.11",
    "lucide-react": "^1.66.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  }
}
